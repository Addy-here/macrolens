{
  "expo": {
    "name": "Macrolens",
    "slug": "app",
    "scheme": "macrolens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adwaitmahadar.macrolens",
      "appleTeamId": "DNYJM6CGV5",
      "icon": "./assets/AppIcon.icon",
      "infoPlist": {
        "EXDevMenuShowFloatingActionButton": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF5C1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Macrolens looks at a photo of your meal to estimate portions. The photo is sent only to the AI provider whose key you saved.",
          "cameraPermission": "Macrolens uses the camera to photograph a meal for an estimate you review before it is logged."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Macrolens listens while you say what you ate, so it can log it for you.",
          "speechRecognitionPermission": "Macrolens turns what you say into foods on this iPhone. Your voice is not stored."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#FF5C1A"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-quick-actions"
    ]
  }
}
